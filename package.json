{
  "name": "safariasili",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "dev:webpack": "next dev --no-turbo",
    "build": "next build",
    "start": "tsx server.ts --prod",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:start": "docker compose up -d --build --wait postgres",
    "db:stop": "docker compose stop postgres",
    "studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "npm run db:start && npm run db:migrate",
    "db:reset": "docker compose down -v && npm run db:start",
    "db:dump": "docker compose exec -T postgres pg_dump -U safari_admin -d safaribookings_db --no-owner --no-privileges --encoding=UTF8 > docker/postgres/init/01-safaribookings.sql"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.475.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
