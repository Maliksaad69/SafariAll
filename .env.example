# Environment Variables Configuration

# Self-Hosted PostgreSQL Database Connection (Docker, see docker-compose.yml)
# Host port 5433 is used because a local PostgreSQL service may already own 5432.
POSTGRES_USER=safari_admin
POSTGRES_PASSWORD=SafariSecurePass2026!
POSTGRES_DB=safaribookings_db
POSTGRES_PORT=5433

# Prisma Database Connection String
DATABASE_URL="postgresql://safari_admin:SafariSecurePass2026!@localhost:5433/safaribookings_db?schema=public&connection_limit=20"

# Next.js Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-nextauth-token-safari-2026-key"
NEXTAUTH_URL="http://localhost:3000"

# Optional Cloud Storage & Mailer
S3_BUCKET_NAME="safari-marketplace-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_sendgrid_api_key"

# Real-time chat on serverless hosts (Vercel, Netlify): optional Pusher Channels keys.
# Without them the chat still works everywhere using a live stream from Postgres
# (about 1 second delay); on a Node server (npm start) socket.io is used instead.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Secret used to sign login sessions. Set a long random value in production (e.g. on Vercel).
JWT_SECRET=""
