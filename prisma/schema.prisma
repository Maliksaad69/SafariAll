// Prisma Schema Definition for SafariAsili (SafariBookings Clone)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TRAVELER
  OPERATOR
  ADMIN
}

enum ComfortLevel {
  CAMPING
  BUDGET
  MID_RANGE
  LUXURY
  SUPER_LUXURY
}

enum TourType {
  PRIVATE
  SHARED_GROUP
  FLY_IN
  SELF_DRIVE
}

enum DestinationType {
  NATIONAL_PARK
  GAME_RESERVE
  CONSERVANCY
  COUNTRY
}

enum InquiryStatus {
  PENDING
  ROUTED
  RESPONDED
  CLOSED
}

enum ReservationStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum LeadStatus {
  DISPATCHED
  VIEWED
  PROPOSAL_SENT
  DECLINED
}

enum ReviewStatus {
  PENDING_MODERATION
  APPROVED
  REJECTED
}

// 1. Users Model (Travelers, Operators, Admins)
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  country       String?
  role          Role     @default(TRAVELER)
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  operator     Operator?
  inquiries    Inquiry[]
  reviews      Review[]
  messages     Message[]
  reservations Reservation[]
  reservationMessages ReservationMessage[]
  blogPosts    BlogPost[]

  @@map("users")
}

// 2. Operators Model (Tour Agencies & Licensing)
model Operator {
  id                  String        @id @default(uuid())
  userId              String        @unique @map("user_id")
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String        @map("company_name")
  slug                String        @unique
  logoUrl             String?       @map("logo_url")
  bannerUrl           String?       @map("banner_url")
  countryOfOrigin     String        @map("country_of_origin")
  headquartersAddress String?       @map("headquarters_address")
  registrationNumber  String?       @map("registration_number")
  licenseDocumentUrl  String?       @map("license_document_url")
  isVerified          Boolean       @default(false) @map("is_verified")
  verificationDate    DateTime?     @map("verification_date")
  overviewText        String?       @map("overview_text") @db.Text
  yearEstablished     Int?          @map("year_established")
  priceTier           ComfortLevel? @default(MID_RANGE) @map("price_tier")
  averageRating       Float         @default(0.00) @map("average_rating")
  totalReviews        Int           @default(0) @map("total_reviews")
  createdAt           DateTime      @default(now()) @map("created_at")

  // Relations
  tours        Tour[]
  leads        InquiryLead[]
  reviews      Review[]
  reservations Reservation[]
  blogPosts    BlogPost[]

  @@map("operators")
}

// 3. Destinations & National Parks Model
model Destination {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  country          String
  type             DestinationType
  description      String?         @db.Text
  featuredImageUrl String?         @map("featured_image_url")
  latitude         Float?
  longitude        Float?
  bestTimeToVisit  Json?           @map("best_time_to_visit")
  wildlifePresent  Json?           @map("wildlife_present")
  createdAt        DateTime        @default(now()) @map("created_at")

  // Relations
  tours TourDestination[]
  sections DestinationSection[]

  @@map("destinations")
}

// 3b. Travel Guide Sections for Destinations (parks & countries)
// key matches the sidebar topics: overview, parks-reserves, things-to-do, best-beaches,
// reviews, wildlife, birds, best-time, weather-climate, popular-routes, getting-there,
// health-safety, staying-safe
model DestinationSection {
  id            String      @id @default(uuid())
  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  key           String
  title         String
  body          String      @db.Text
  // optional list items rendered under the section body (e.g. park lists, route lists)
  bulletItems   String[]    @default([]) @map("bullet_items")
  sortOrder     Int         @default(0) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([destinationId, key])
  @@map("destination_sections")
}

// 4. Tours Model
model Tour {
  id             String       @id @default(uuid())
  operatorId     String       @map("operator_id")
  operator       Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  title          String
  slug           String       @unique
  durationDays   Int          @map("duration_days")
  durationNights Int          @map("duration_nights")
  minPriceUsd    Float        @map("min_price_usd")
  maxPriceUsd    Float?       @map("max_price_usd")
  comfortLevel   ComfortLevel @map("comfort_level")
  tourType       TourType     @map("tour_type")
  primaryCountry String       @map("primary_country")
  startLocation  String?      @map("start_location")
  endLocation    String?      @map("end_location")
  inclusions     String[]
  exclusions     String[]
  isPublished    Boolean      @default(true) @map("is_published")
  createdAt      DateTime     @default(now()) @map("created_at")

  // Relations
  destinations TourDestination[]
  itineraries  TourItinerary[]
  slots        TourSlot[]
  availability TourAvailability?
  inquiries    Inquiry[]
  reviews      Review[]
  reservations Reservation[]

  @@map("tours")
}

// 5. Tour Destinations Junction Model
model TourDestination {
  tourId        String      @map("tour_id")
  destinationId String      @map("destination_id")
  tour          Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([tourId, destinationId])
  @@map("tour_destinations")
}

// 5b. Departure Slots Model (per-tour capacity management)
// Agencies define departure slots; or leave datesOpen for unlimited open-dated bookings.
model TourSlot {
  id             String   @id @default(uuid())
  tourId         String   @map("tour_id")
  tour           Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startDate      DateTime @map("start_date")
  maxTravelers   Int      @map("max_travelers")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  reservations Reservation[]

  @@unique([tourId, startDate])
  @@map("tour_slots")
}

// 5c. Tour Availability Settings (per-tour capacity mode)
// mode: OPEN_DATED (any date accepted, optional total cap) | SLOTS (fixed departure slots)
model TourAvailability {
  tourId        String  @id @map("tour_id")
  tour          Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  mode          String  @default("OPEN_DATED")
  totalCapacity Int?    @map("total_capacity")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tour_availability")
}

// 12. Blog Posts Model (agencies publish marketing articles tied to their packages)
model BlogPost {
  id          String   @id @default(uuid())
  operatorId  String   @map("operator_id")
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  authorId    String   @map("author_id")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.Text
  coverImageUrl String? @map("cover_image_url")
  tag         String?
  status      String   @default("PUBLISHED")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([operatorId])
  @@map("blog_posts")
}

// 13. Agency <-> Traveler Thread Messages (per reservation)
model ReservationMessage {
  id            String     @id @default(uuid())
  reservationId String     @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  senderId      String     @map("sender_id")
  sender        User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body          String     @db.Text
  isRead        Boolean    @default(false) @map("is_read")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([reservationId])
  @@map("reservation_messages")
}

// 6. Tour Day-by-Day Itineraries Model
model TourItinerary {
  id                String        @id @default(uuid())
  tourId            String        @map("tour_id")
  tour              Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  dayNumber         Int           @map("day_number")
  title             String
  description       String        @db.Text
  accommodationName String?       @map("accommodation_name")
  accommodationType ComfortLevel? @map("accommodation_type")
  mealsIncluded     String?       @map("meals_included")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("tour_itineraries")
}

// 7. Inquiries Model (Quote Requests)
model Inquiry {
  id                 String        @id @default(uuid())
  travelerId         String        @map("traveler_id")
  traveler           User          @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  tourId             String?       @map("tour_id")
  tour               Tour?         @relation(fields: [tourId], references: [id], onDelete: SetNull)
  preferredCountry   String?       @map("preferred_country")
  travelDateStart    DateTime?     @map("travel_date_start")
  travelDateEnd      DateTime?     @map("travel_date_end")
  isFlexibleDates    Boolean       @default(true) @map("is_flexible_dates")
  adultsCount        Int           @default(1) @map("adults_count")
  childrenCount      Int           @default(0) @map("children_count")
  budgetPerPersonUsd Float?        @map("budget_per_person_usd")
  comfortPreference  ComfortLevel? @map("comfort_preference")
  customNotes        String?       @map("custom_notes") @db.Text
  isBroadcast        Boolean       @default(false) @map("is_broadcast")
  status             InquiryStatus @default(PENDING)
  createdAt          DateTime      @default(now()) @map("created_at")

  // Relations
  leads InquiryLead[]

  @@map("inquiries")
}

// 8. Inquiry Leads Dispatched to Operators
model InquiryLead {
  id         String     @id @default(uuid())
  inquiryId  String     @map("inquiry_id")
  inquiry    Inquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  operatorId String     @map("operator_id")
  operator   Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  status     LeadStatus @default(DISPATCHED)
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  messages Message[]

  @@map("inquiry_leads")
}

// 9. Messages Model
model Message {
  id             String      @id @default(uuid())
  inquiryLeadId  String      @map("inquiry_lead_id")
  inquiryLead    InquiryLead @relation(fields: [inquiryLeadId], references: [id], onDelete: Cascade)
  senderId       String      @map("sender_id")
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String      @db.Text
  attachmentUrls String[]    @map("attachment_urls")
  isRead         Boolean     @default(false) @map("is_read")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("messages")
}

// 10. Reviews Model
model Review {
  id                      String       @id @default(uuid())
  operatorId              String       @map("operator_id")
  operator                Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  tourId                  String?      @map("tour_id")
  tour                    Tour?        @relation(fields: [tourId], references: [id], onDelete: SetNull)
  travelerId              String       @map("traveler_id")
  traveler                User         @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  overallRating           Float        @map("overall_rating")
  guideRating             Float?       @map("guide_rating")
  vehicleRating           Float?       @map("vehicle_rating")
  valueRating             Float?       @map("value_rating")
  itineraryAccuracyRating Float?       @map("itinerary_accuracy_rating")
  reviewTitle             String       @map("review_title")
  reviewBody              String       @map("review_body") @db.Text
  travelDate              DateTime?    @map("travel_date")
  isVerifiedBooking       Boolean      @default(true) @map("is_verified_booking")
  status                  ReviewStatus @default(PENDING_MODERATION)
  operatorReply           String?      @map("operator_reply") @db.Text
  createdAt               DateTime     @default(now()) @map("created_at")

  @@map("reviews")
}

// 11. Reservations Model (Booking Requests with Approval Workflow)
model Reservation {
  id                String            @id @default(uuid())
  reference         String            @unique @default(cuid())
  travelerId        String            @map("traveler_id")
  traveler          User              @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  tourId            String            @map("tour_id")
  tour              Tour              @relation(fields: [tourId], references: [id], onDelete: Cascade)
  operatorId        String            @map("operator_id")
  operator          Operator          @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  startDate         DateTime          @map("start_date")
  adultsCount       Int               @map("adults_count")
  childrenCount     Int               @default(0) @map("children_count")
  specialRequests   String?           @map("special_requests") @db.Text
  estimatedTotalUsd Float             @map("estimated_total_usd")
  status            ReservationStatus @default(PENDING)
  operatorNote      String?           @map("operator_note") @db.Text
  decidedAt         DateTime?         @map("decided_at")
  slotId            String?           @map("slot_id")
  slot              TourSlot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  messages          ReservationMessage[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("reservations")
}
